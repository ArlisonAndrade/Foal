# Credenciais do Notion — usadas apenas pelas Serverless Functions em api/
# (configure as mesmas variaveis no painel da Vercel: Settings > Environment Variables)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=00000000000000000000000000000000

# Opcional: banco separado para os grupamentos (api/grupamentos.js).
# Se ausente, cai no NOTION_DATABASE_ID.
NOTION_GRUPAMENTOS_DB_ID=

# Opcional, apenas para desenvolvimento local (.env.local):
# o front chama /api/salvar na mesma origem. Como `vite dev` nao executa as
# functions da Vercel, aponte para um deploy que as tenha, ou use `vercel dev`.
# VITE_API_BASE=https://foal-app.vercel.app
